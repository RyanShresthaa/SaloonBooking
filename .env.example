# =============================================================================
# Salon monorepo — one reference for every env var this project uses.
#
# How to use (tools do not auto-split this file):
#   1. Copy the BACKEND block into   backend/.env
#   2. Copy the FRONTEND block into  frontend/.env.local
#   3. Never commit real secrets; keep your real files out of git (see .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND — Node API (backend/.env)
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Browser origin of the SPA (email links, CORS). Match your Vite port locally.
# Production: set to your live site, e.g. https://saloon-booking-virid.vercel.app
# Multiple origins (CORS): comma-separated, first is used for email links.
CLIENT_URL=http://localhost:5174

# Admin seed (npm run db:seed:admin in backend/)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# POST /api/staff/team/seed-demo — min 6 chars; required in production (see backend/src/config/Env.js)
STAFF_SEED_PASSWORD=

# Postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Optional: set DB_SSL=0 only for production-mode CLI against local Postgres without TLS (not for Render).
DB_SSL=

JWT_SECRET=
JWT_EXPIRES_IN=7d

# SMTP (optional in dev — verify links may log to console instead)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Redis (Bull queue / notifications)
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional: log slow requests over this many ms (default 1200)
SLOW_REQUEST_MS=1200

# Feature flags — set to "0" to disable (defaults enabled where noted in Env.js)
FEATURE_REMINDER_EMAILS=
FEATURE_RETAIL=
FEATURE_WAITLIST=
FEATURE_VISIT_FEEDBACK=
FEATURE_BULK_NOTIFY=
FEATURE_PUBLIC_BOOKING=

# Stripe (deposits) — requires STRIPE_SECRET_KEY when enabled
FEATURE_STRIPE_DEPOSITS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEPOSIT_AMOUNT_CENTS=2000
STRIPE_CURRENCY=usd

# -----------------------------------------------------------------------------
# FRONTEND — Vite (frontend/.env.local) — must be prefixed with VITE_
# -----------------------------------------------------------------------------

# Production / Vercel: must be your deployed API (never localhost — browsers block it).
# Example: VITE_API_URL=https://your-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Same host as API, no /api (Socket.IO).
# Example: VITE_SOCKET_URL=https://your-api.onrender.com
VITE_SOCKET_URL=http://localhost:5000

# If proxies return 426 on polling, try: true
# VITE_SOCKET_POLLING_FIRST=true

# -----------------------------------------------------------------------------
# TOOLING (optional — set in shell or CI, not always in .env)
# -----------------------------------------------------------------------------

# Playwright (frontend) — when dev server is not default URL/port
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:5174
