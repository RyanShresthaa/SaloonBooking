# Copy to .env and adjust values.

NODE_ENV=development
PORT=5000

CLIENT_URL=http://localhost:5174

# Optional: npm run db:seed:admin — creates/updates admin (bcrypt-hashed in DB)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Demo stylists (POST /api/staff/team/seed-demo and More → Staff in the app). Min 6 characters.
# Optional in development: if unset, the API uses a built-in dev password (see Env.js). Required in production.
STAFF_SEED_PASSWORD=ryan123

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=7d

# SMTP (optional in dev — register still works; check server logs for verify URL)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Feature flags (set to "0" to disable; default enabled)
FEATURE_REMINDER_EMAILS=
FEATURE_RETAIL=
FEATURE_WAITLIST=
FEATURE_VISIT_FEEDBACK=
FEATURE_BULK_NOTIFY=

# Public booking API (GET /api/public/services, /available-slots). Set FEATURE_PUBLIC_BOOKING=0 to disable routes.
FEATURE_PUBLIC_BOOKING=

# Stripe deposit checkout (POST /api/billing/deposit-checkout). Requires STRIPE_SECRET_KEY.
FEATURE_STRIPE_DEPOSITS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEPOSIT_AMOUNT_CENTS=2000
STRIPE_CURRENCY=usd
