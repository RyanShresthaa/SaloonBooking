# Copy to .env and adjust values.
# Full monorepo variable list: see `/.env.example` at the repository root.

NODE_ENV=development
PORT=5000
# CORS + email links: one origin, or comma-separated list (first wins for links). Production example:
# CLIENT_URL=https://your-app.vercel.app
CLIENT_URL=http://localhost:5174


# Optional: npm run db:seed:admin — creates/updates admin (bcrypt-hashed in DB)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Demo stylists (POST /api/staff/team/seed-demo and More → Staff in the app). Min 6 characters.
# Optional in development: if unset, the API uses a built-in dev password (see Env.js). Required in production.
STAFF_SEED_PASSWORD=ryan123

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
# Production migrations to Render: use External host from Render dashboard (not localhost).
# If you ever run production env against local Postgres only: DB_SSL=0 (not for Render cloud)
DB_SSL=
DB_NAME=
DB_USER=
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Set to 1 to require email verification (send mail, block login until verified). Default: off — customers register verified and can sign in immediately.
AUTH_EMAIL_VERIFICATION_REQUIRED=

# Mail transport: auto (Resend if RESEND_API_KEY else SMTP) | resend (API only) | smtp (EMAIL_* only).
# Production with Resend: set MAIL_PROVIDER=resend and RESEND_API_KEY (never uses Gmail SMTP).
MAIL_PROVIDER=auto

# --- Resend (HTTPS API — recommended on Render) ---
# https://resend.com → API Keys → create key. Verify a sending domain, then set FROM to that domain.
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend (NOT @gmail.com / @yahoo.com as "from").
# Example: "Salon <noreply@yourdomain.com>". Leave empty to use Resend's onboarding sender (strict recipient limits).
EMAIL_FROM=

# --- SMTP (optional if RESEND_API_KEY is set) ---
# Gmail from Render often times out (ETIMEDOUT); prefer RESEND_API_KEY + EMAIL_FROM above.
# Do NOT use localhost/127.0.0.1 on Render. If unset, signup still works; API may return verificationEmailQueued: false.
#
# Gmail (local/laptop): smtp.gmail.com, 587. Use a Google App Password (2-Step Verification), not your normal password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Feature flags (set to "0" to disable; default enabled)
FEATURE_REMINDER_EMAILS=
FEATURE_RETAIL=
FEATURE_WAITLIST=
FEATURE_VISIT_FEEDBACK=
FEATURE_BULK_NOTIFY=

# Public booking API (GET /api/public/services, /available-slots). Set FEATURE_PUBLIC_BOOKING=0 to disable routes.
FEATURE_PUBLIC_BOOKING=

# Stripe deposit checkout (POST /api/billing/deposit-checkout). Requires STRIPE_SECRET_KEY.
FEATURE_STRIPE_DEPOSITS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEPOSIT_AMOUNT_CENTS=2000
STRIPE_CURRENCY=usd
STRIPE_CURRENCY=usd
