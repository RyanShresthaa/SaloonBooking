# Copy to `.env` and fill in values. Never commit real `.env`.

NODE_ENV=development
PORT=5000

# --- PostgreSQL (local example: pgAdmin / PostgreSQL 18 on this machine) ---
# Avoid hyphens in the DB name unless you enjoy quoting: prefer `Saloon_db` or `saloon_db`.
# If you really want `Saloon-db`, create it as: CREATE DATABASE "Saloon-db";
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Saloon_db
DB_USER=postgres
DB_PASSWORD=change-me
# Local dev: turn SSL off explicitly (cloud hosts often need SSL on).
DB_SSL=false

JWT_SECRET=use-a-long-random-string-in-real-env
JWT_EXPIRES_IN=7d

# Bootstrap first tenant admin (see seeders/20250610120000-admin-bootstrap.js); both required to run seed.
ADMIN_BOOTSTRAP_EMAIL=you@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me

# Demo marketplace desk logins (see seeders/20250622120500-demo-marketplace-desk-owners.js and docs/demo-marketplace-desk-logins.md).
# If unset, the seeder uses password SalonDemo1! — override in any shared/staging environment.
DEMO_SALON_OWNER_PASSWORD=SalonDemo1!

CLIENT_URL=http://localhost:5173

# Email on Render / production: see docs/deploy-render-email.md (Resend RESEND_API_KEY + EMAIL_FROM, or SMTP).
# Free Render demo (Velvet login + share URL): see docs/deploy-free-render-velvet-demo.md

# Optional: Redis, email, Stripe — see src/config/Env.js
