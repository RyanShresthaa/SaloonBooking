{
  "name": "salon-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node -e \"console.log('No automated tests configured.'); process.exit(0);\"",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:admin": "sequelize-cli db:seed --seed 20250610120000-admin-bootstrap.js",
    "db:seed:demo-salons": "sequelize-cli db:seed --seed 20250622120000-demo-four-marketplace-salons.js",
    "db:seed:undo:demo-salons": "sequelize-cli db:seed:undo --seed 20250622120000-demo-four-marketplace-salons.js",
    "db:seed:demo-owners": "sequelize-cli db:seed --seed 20250622120500-demo-marketplace-desk-owners.js",
    "db:seed:undo:demo-owners": "sequelize-cli db:seed:undo --seed 20250622120500-demo-marketplace-desk-owners.js",
    "db:seed:demo-retail": "sequelize-cli db:seed --seed 20250622130000-demo-retail-products.js",
    "db:seed:undo:demo-retail": "sequelize-cli db:seed:undo --seed 20250622130000-demo-retail-products.js",
    "db:seed:reprice-nepal": "sequelize-cli db:seed --seed 20250624140000-reprice-nepal-market.js",
    "db:seed:undo:reprice-nepal": "sequelize-cli db:seed:undo --seed 20250624140000-reprice-nepal-market.js",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.5",
    "cors": "^2.8.6",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "socket.io": "^4.8.3",
    "stripe": "^18.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.4"
  }
}
